> # 06 - Matrices (stored column-major, like R)
> m <- matrix(1:6, nrow = 2)
> m
     [,1] [,2] [,3]
[1,]    1    3    5
[2,]    2    4    6
> dim(m)
[1] 2 3
> t(m)
     [,1] [,2]
[1,]    1    2
[2,]    3    4
[3,]    5    6
> m %*% t(m)                     # matrix product
     [,1] [,2]
[1,]   35   44
[2,]   44   56
> m * 10                         # elementwise, keeps the shape
     [,1] [,2] [,3]
[1,]   10   30   50
[2,]   20   40   60
> m[2, ]                         # one row
[1] 2 4 6
> m[, 3]                         # one column
[1] 5 6
> m[m > 3]
[1] 4 5 6
> rowSums(m)
[1]  9 12
> colMeans(m)
[1] 1.5 3.5 5.5
> diag(3)
     [,1] [,2] [,3]
[1,]    1    0    0
[2,]    0    1    0
[3,]    0    0    1

> b <- matrix(1:4, nrow = 2, byrow = TRUE)
> b
     [,1] [,2]
[1,]    1    2
[2,]    3    4
> cbind(1:3, c(10, 20, 30))
     [,1] [,2]
[1,]    1   10
[2,]    2   20
[3,]    3   30
> matrix(c(1.5, 2, 3.25, 40), 2) # each column gets its own number format
     [,1]  [,2]
[1,]  1.5  3.25
[2,]  2.0 40.00
